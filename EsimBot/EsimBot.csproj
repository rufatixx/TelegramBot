<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>EsimBot</RootNamespace>
    <UserSecretsId>TelegramBot-EsimBot-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.4.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="DAL/schema.sql" />
    <Content Remove="BLL/Services/Localization/*.json" />
    <EmbeddedResource Include="BLL/Services/Localization/*.json" WithCulture="false" />
    <Content Remove="BLL/Services/Landing/*.json" />
    <EmbeddedResource Include="BLL/Services/Landing/*.json" WithCulture="false" />
    <None Update="BLL/Services/Localization/UNICODE-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Remove only obsolete generated copies; the owner's source backup is preserved. -->
  <Target Name="RemoveLegacyBuildSettings" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(TargetDir)appsettings.Local.json;$(TargetDir)appsettings.Example.json" />
  </Target>
  <Target Name="RemoveLegacyPublishedSettings" AfterTargets="Publish">
    <Delete Files="$(PublishDir)appsettings.Local.json;$(PublishDir)appsettings.Example.json" />
  </Target>

</Project>
