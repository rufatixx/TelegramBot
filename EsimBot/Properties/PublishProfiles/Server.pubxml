<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <EnvironmentName>Production</EnvironmentName>
    <PublishDir>$(MSBuildProjectDirectory)/../artifacts/esim-bot-server/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
  <!-- appsettings.json is already filled and included by the project for every publish profile.
       This profile only selects the private server output directory and IIS environment. -->
</Project>
